# Copy this file to .env.local and fill in real values. Never commit .env.local.

# Flagsmith › SDK Keys › Server-side environment key (starts with "ser.")
FLAGSMITH_SERVER_KEY=

# Flagsmith › SDK Keys › Client-side environment key (also used in Admin API paths)
FLAGSMITH_ENVIRONMENT_KEY=

# Flagsmith › Organisation Settings › API Keys (used by the agent only)
FLAGSMITH_ADMIN_API_KEY=

# ID of the checkout_nudge experiment (filled in after the experiment is created)
FLAGSMITH_EXPERIMENT_ID=

# Optional: only for self-hosted Flagsmith (the load test sets these itself)
# FLAGSMITH_API_URL=https://flagsmith.example.com/api/v1/
# FLAGSMITH_EVENTS_API_URL=https://flagsmith.example.com/

# Google AI Studio API key, free tier (optional: the agent falls back to templates)
GEMINI_API_KEY=
